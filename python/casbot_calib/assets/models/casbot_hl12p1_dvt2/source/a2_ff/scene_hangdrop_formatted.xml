<?xml version="1.0" ?>
<mujoco model="scene">

	<include file="mujoco_description_formatted.xml"/>
	<statistic center="0.4 0 0.5" extent="3"/>

	<option integrator="implicitfast" timestep="0.002"/>

	<visual>
		<headlight ambient="0.1 0.1 0.1" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
		<rgba haze="0.15 0.25 0.35 1"/>
		<global azimuth="120" elevation="-20"/>
	</visual>

	<asset>
		<texture builtin="gradient" height="3072" rgb1="0.3 0.5 0.7" rgb2="0 0 0" type="skybox" width="512"/>
		<texture builtin="checker" height="300" mark="edge" markrgb="0.8 0.8 0.8" name="groundplane" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" type="2d" width="300"/>
		<material name="groundplane" texrepeat="5 5" texture="groundplane" texuniform="true"/>
	</asset>

	<worldbody>
		<geom condim="3" friction="0.7" material="groundplane" name="floor" size="0 0 .05" type="plane"/>
		<light diffuse="0.9 0.9 0.9" dir="0 0 -5" directional="true" pos="0 0 10"/>
		<body mocap="true" name="base_anchor" pos="0 0 0.02">
			<geom conaffinity="0" contype="0" rgba="1 0 0 0.3" size="0.02" type="sphere"/>
		</body>
	</worldbody>

	<equality>
		<weld active="true" body1="base_footprint" body2="base_anchor" name="base_weld" relpose="0 0 0 1 0 0 0"/>
	</equality>
</mujoco>