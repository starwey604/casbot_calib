# Executed by the amd64 orin-x86-cross-builder image.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CALIB_ORIN_CROSS ON CACHE BOOL "Build for the Orin Jammy runtime")
set(CMAKE_SYSROOT /sysroot/arm64)
set(CMAKE_C_COMPILER /usr/bin/clang-22)
set(CMAKE_CXX_COMPILER /usr/bin/clang++-22)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN /sysroot/arm64/usr)
set(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN /sysroot/arm64/usr)
set(CMAKE_AR /usr/bin/llvm-ar-22)
set(CMAKE_RANLIB /usr/bin/llvm-ranlib-22)
set(CMAKE_NM /usr/bin/llvm-nm-22)
set(CMAKE_C_COMPILER_AR /usr/bin/llvm-ar-22)
set(CMAKE_CXX_COMPILER_AR /usr/bin/llvm-ar-22)
set(CMAKE_C_COMPILER_RANLIB /usr/bin/llvm-ranlib-22)
set(CMAKE_CXX_COMPILER_RANLIB /usr/bin/llvm-ranlib-22)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a78ae")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a78ae")
foreach(kind EXE SHARED MODULE)
  set(CMAKE_${kind}_LINKER_FLAGS_INIT "-fuse-ld=lld-22 -L/opt/orin-openmp/lib")
endforeach()
set(CMAKE_FIND_ROOT_PATH /sysroot/arm64)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_PREFIX_PATH /opt/ros/humble CACHE STRING "Target mathematics packages")
set(CMAKE_INSTALL_LIBDIR lib CACHE PATH "Target library installation directory")
set(OpenMP_CXX_FLAGS "-fopenmp=libomp -isystem /opt/orin-openmp/include" CACHE STRING "")
set(OpenMP_CXX_LIB_NAMES omp CACHE STRING "")
set(OpenMP_omp_LIBRARY /opt/orin-openmp/lib/libomp.so.5 CACHE FILEPATH "")
# CMake package imports also inspect the target's Python development files.
set(Python3_EXECUTABLE /opt/crossenv/cross/bin/python CACHE FILEPATH "")
set(Python3_INCLUDE_DIR /sysroot/arm64/usr/include/python3.10 CACHE PATH "")
set(_calib_target_numpy_include /opt/crossenv/cross/lib/python3.10/site-packages/numpy/core/include)
set(NUMPY_INCLUDE_DIRS "${_calib_target_numpy_include}" CACHE PATH "")
set(Python3_NumPy_INCLUDE_DIR "${_calib_target_numpy_include}" CACHE PATH "")
set(Python_NumPy_INCLUDE_DIR "${_calib_target_numpy_include}" CACHE PATH "")
set(Python_EXECUTABLE /opt/crossenv/cross/bin/python CACHE FILEPATH "")
set(Python_INCLUDE_DIR /sysroot/arm64/usr/include/python3.10 CACHE PATH "")
