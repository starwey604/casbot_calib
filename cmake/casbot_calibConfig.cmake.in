@PACKAGE_INIT@
# Capture our relocatable prefix before dependency configs set PACKAGE_PREFIX_DIR.
set(casbot_calib_MODEL_DIRECTORY "@PACKAGE_CMAKE_INSTALL_DATADIR@/casbot_calib/models")
set(casbot_calib_Core_FOUND FALSE)
set(casbot_calib_Shm_FOUND FALSE)
if(@CALIB_BUILD_CORE@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/casbot_calibTargets.cmake")
  set(casbot_calib_Core_FOUND TRUE)
endif()
if(@CALIB_BUILD_SHM@ AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/casbot_calibShmTargets.cmake")
  set(casbot_calib_Shm_FOUND TRUE)
endif()
set(casbot_calib_Models_FOUND FALSE)
if(EXISTS "${casbot_calib_MODEL_DIRECTORY}")
  set(casbot_calib_Models_FOUND TRUE)
endif()
set(_calib_components "${casbot_calib_FIND_COMPONENTS}")
if(NOT _calib_components)
  if(casbot_calib_Core_FOUND)
    list(APPEND _calib_components Core)
  endif()
  if(casbot_calib_Shm_FOUND)
    list(APPEND _calib_components Shm)
  endif()
endif()
include(CMakeFindDependencyMacro)
foreach(_calib_component IN LISTS _calib_components)
  if(_calib_component STREQUAL "Core" AND casbot_calib_Core_FOUND)
    find_dependency(Eigen3 3.4 CONFIG)
    find_dependency(Boost 1.74 CONFIG)
    find_dependency(pinocchio 3.9 CONFIG)
    find_dependency(coal 3.0 CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/casbot_calibTargets.cmake")
  elseif(_calib_component STREQUAL "Shm" AND casbot_calib_Shm_FOUND)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/casbot_calibShmTargets.cmake")
  endif()
endforeach()
check_required_components(casbot_calib)
