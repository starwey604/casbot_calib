@PACKAGE_INIT@
# Capture our relocatable prefix before dependency configs set PACKAGE_PREFIX_DIR.
# Optional Models component; finding the core alone must not require assets.
set(casbot_calib_MODEL_DIRECTORY "@PACKAGE_CMAKE_INSTALL_DATADIR@/casbot_calib/models")
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.4 CONFIG)
find_dependency(Boost 1.74 CONFIG)
find_dependency(pinocchio 3.9 CONFIG)
find_dependency(coal 3.0 CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/casbot_calibTargets.cmake")
check_required_components(casbot_calib)
