{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "conda",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/conda",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{CONDA_PREFIX};$env{CONDA_PREFIX}/Library"
      }
    },
    {
      "name": "humble",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/humble",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/opt/ros/humble",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/humble-native",
        "pybind11_DIR": "$env{VIRTUAL_ENV}/lib/python3.10/site-packages/pybind11/share/cmake/pybind11",
        "Python_EXECUTABLE": "$env{VIRTUAL_ENV}/bin/python"
      }
    },
    {
      "name": "shm-native",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/shm-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CALIB_BUILD_CORE": "OFF",
        "CALIB_BUILD_PYTHON": "OFF",
        "CALIB_BUILD_SHM": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/shm-native"
      }
    },
    {
      "name": "shm-core",
      "inherits": "shm-native",
      "binaryDir": "${sourceDir}/build/shm-core",
      "cacheVariables": {
        "CALIB_BUILD_CORE": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/shm-core"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "conda",
      "configurePreset": "conda"
    },
    {
      "name": "humble",
      "configurePreset": "humble",
      "jobs": 1
    },
    {
      "name": "shm-native",
      "configurePreset": "shm-native",
      "jobs": 1
    },
    {
      "name": "shm-core",
      "configurePreset": "shm-core",
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "conda",
      "configurePreset": "conda",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "humble",
      "configurePreset": "humble",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "shm-native",
      "configurePreset": "shm-native",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "shm-core",
      "configurePreset": "shm-core",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
